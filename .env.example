# Copy to .env and fill in your credentials.
# Any OpenAI-compatible endpoint works (Groq, OpenAI, Ollama, LM Studio, ...)
VITE_AI_BASE_URL=https://api.groq.com/openai/v1
VITE_AI_API_KEY=your-api-key-here
VITE_AI_MODEL=qwen/qwen3.6-27b
# Model for audio-chunk transcription (Groq: whisper-large-v3 | whisper-large-v3-turbo)
VITE_TRANSCRIBE_MODEL=whisper-large-v3-turbo
